# ============================================
# LUCERO TRP - Variables de Entorno (EJEMPLO)
# ============================================
# Copia este archivo como .env y llena los valores
# NUNCA subas el archivo .env al repositorio

# Servidor
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# MongoDB (de Render o Atlas)
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/luceroTRPdb?retryWrites=true&w=majority

# JWT (genera secrets fuertes de 32+ bytes)
JWT_SECRET=GENERAR_SECRET_ALEATORIO_32_BYTES
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=GENERAR_REFRESH_SECRET_ALEATORIO_32_BYTES
JWT_REFRESH_EXPIRATION=7d

# WebSocket
WS_CORS_ORIGIN=https://tu-dominio.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (dominios permitidos, separados por coma)
CORS_ORIGIN=https://tu-dominio.com

# Logs
LOG_LEVEL=info

# Firebase Admin SDK (JSON completo del service account)
# IMPORTANTE: En Render, usa la variable de entorno, NO el archivo .json
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"tu-project-id","private_key":"-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@tu-project.iam.gserviceaccount.com"}

# Cloudinary (uploads firmados)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_UPLOAD_PRESET=lucero-trp-signed
